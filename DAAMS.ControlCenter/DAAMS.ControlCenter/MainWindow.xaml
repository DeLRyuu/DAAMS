<Window x:Class="ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ControlCenter.ViewModels"
        xmlns:views="clr-namespace:ControlCenter.Views"
        xmlns:conv="clr-namespace:ControlCenter.Converters"
        xmlns:svc="clr-namespace:ControlCenter.Services"
        Title="DAAMS Control Center"
        Height="820" Width="1360"
        MinHeight="700" MinWidth="1100"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:FirestoreConnectionStateToBrushConverter x:Key="FirestoreStateBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- ViewModel -> View mapping. This is the whole navigation mechanism:
             MainViewModel swaps CurrentViewModel, the ContentControl below
             picks the matching DataTemplate automatically. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProtectedAssetsViewModel}">
            <views:ProtectedAssetsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityLogsViewModel}">
            <views:ActivityLogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CasesViewModel}">
            <views:CasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncidentReportsViewModel}">
            <views:IncidentReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,26">
                    <TextBlock Text="DAAMS" Style="{StaticResource Text.SectionHeading}" FontSize="18" />
                    <TextBlock Text="Control Center" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- System status footer -->
                <Border DockPanel.Dock="Bottom" Margin="20,0,20,20"
                        BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource Brush.StatusPositive}" />
                            <TextBlock Text="Local DB: 2 pending sync" ToolTip="Local DB: 2 pending sync" Style="{StaticResource Text.Secondary}"
                                       Margin="8,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{Binding FirestoreState, Converter={StaticResource FirestoreStateBrush}}" />
                            <TextBlock Text="{Binding FirestoreStatusText}" Style="{StaticResource Text.Secondary}"
                                       Margin="8,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nav items -->
                <StackPanel Margin="8,0">
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}" Content="Dashboard"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.Dashboard}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.Dashboard}}" />
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}" Content="Protected Assets"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.ProtectedAssets}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.ProtectedAssets}}" />
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}" Content="Activity Logs" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.ActivityLogs}" IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.ActivityLogs}, Mode=OneWay}" />
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}" Content="Devices"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.Devices}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.Devices}}" />
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.SecurityAlerts}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.SecurityAlerts}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Security Alerts" />
                            <Border Background="{StaticResource Brush.Accent}"
                                    CornerRadius="8" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CasesViewModel.HasNeedsReview, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding CasesViewModel.NeedsReviewCount, Mode=OneWay}"
                                           Foreground="{StaticResource Brush.TextOnAccent}"
                                           FontSize="{StaticResource FontSize.Micro}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}" Content="Incident Reports"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.IncidentReports}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.IncidentReports}}" />
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}" Content="Settings"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.Settings}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.Settings}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== CONTENT ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsRangeBarVisible, Converter={StaticResource BoolToVisibility}}">
                    <RadioButton GroupName="TimeRangeSegment" Style="{StaticResource Segment.Item}" Content="Today" Margin="0,0,4,0"
                                 IsChecked="{Binding Range, Source={x:Static svc:ViewContext.Current}, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static svc:TimeRange.Today}}" />
                    <RadioButton GroupName="TimeRangeSegment" Style="{StaticResource Segment.Item}" Content="7 days" Margin="0,0,4,0"
                                 IsChecked="{Binding Range, Source={x:Static svc:ViewContext.Current}, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static svc:TimeRange.Last7Days}}" />
                    <RadioButton GroupName="TimeRangeSegment" Style="{StaticResource Segment.Item}" Content="30 days" Margin="0,0,4,0"
                                 IsChecked="{Binding Range, Source={x:Static svc:ViewContext.Current}, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static svc:TimeRange.Last30Days}}" />
                    <RadioButton GroupName="TimeRangeSegment" Style="{StaticResource Segment.Item}" Content="All"
                                 IsChecked="{Binding Range, Source={x:Static svc:ViewContext.Current}, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static svc:TimeRange.All}}" />
                </StackPanel>

                <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
