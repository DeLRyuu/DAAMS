<Window x:Class="ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ControlCenter.ViewModels"
        xmlns:views="clr-namespace:ControlCenter.Views"
        xmlns:conv="clr-namespace:ControlCenter.Converters"
        Title="DAAMS Control Center"
        Height="820" Width="1360"
        MinHeight="640" MinWidth="1040"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />

        <!-- ViewModel -> View mapping. This is the whole navigation mechanism:
             MainViewModel swaps CurrentViewModel, the ContentControl below
             picks the matching DataTemplate automatically. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProtectedAssetsViewModel}">
            <views:ProtectedAssetsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityLogsViewModel}">
            <views:ActivityLogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SecurityAlertsViewModel}">
            <views:SecurityAlertsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncidentReportsViewModel}">
            <views:IncidentReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,26">
                    <TextBlock Text="DAAMS" Style="{StaticResource Text.SectionHeading}" FontSize="18" />
                    <TextBlock Text="Control Center" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- System status footer -->
                <Border DockPanel.Dock="Bottom" Margin="20,0,20,20"
                        BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.StatusInactive}" VerticalAlignment="Center" />
                            <TextBlock Text="Firestore: Not Connected" Style="{StaticResource Text.Secondary}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Phase 2 — Functional Sections (Mock Data)" Style="{StaticResource Text.Secondary}"
                                   Foreground="{StaticResource Brush.TextTertiary}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Nav items -->
                <StackPanel Margin="8,0">
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}" Content="Dashboard"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.Dashboard}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.Dashboard}}" />
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}" Content="Protected Assets"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.ProtectedAssets}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.ProtectedAssets}}" />
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}" Content="Activity Logs"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.ActivityLogs}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.ActivityLogs}}" />
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}" Content="Security Alerts"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.SecurityAlerts}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.SecurityAlerts}}" />
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}" Content="Incident Reports"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.IncidentReports}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.IncidentReports}}" />
                    <RadioButton GroupName="MainNav" Style="{StaticResource Nav.Item}" Content="Settings"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavigationSection.Settings}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static vm:NavigationSection.Settings}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== CONTENT ==================== -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
