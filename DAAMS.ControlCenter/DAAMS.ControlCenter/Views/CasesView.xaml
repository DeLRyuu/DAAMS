<UserControl x:Class="ControlCenter.Views.CasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ControlCenter.Models"
             xmlns:conv="clr-namespace:ControlCenter.Converters"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <conv:RiskLevelToBrushConverter x:Key="RiskBrush" />
        <conv:ClassificationToBrushConverter x:Key="ClassBrush" />
        <conv:DataLoadStateToVisibilityConverter x:Key="LoadStateVis" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:GroupExpandedConverter x:Key="GroupExpandedConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Layout.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Alerts" Style="{StaticResource Text.PageTitle}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBox Style="{StaticResource Input.TextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search by alert, user, device, asset, or path" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNothingNeedsReview}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.StatusPositive}" Margin="0,0,8,0" />
                        <TextBlock Text="Nothing needs review." Style="{StaticResource Text.Secondary}" />
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander Margin="0,0,0,10" Style="{StaticResource Expander.Modern}">
                                                    <Expander.IsExpanded>
                                                        <MultiBinding Converter="{StaticResource GroupExpandedConverter}" Mode="OneWay">
                                                            <Binding Path="Name" Mode="OneWay" />
                                                            <Binding Path="DataContext.SelectedGroup" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                        </MultiBinding>
                                                    </Expander.IsExpanded>
                                                    <Expander.Header>
                                                        <TextBlock Style="{StaticResource Text.Label}" Margin="2,8,0,8">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} ({1})">
                                                                    <Binding Path="Name" Mode="OneWay" />
                                                                    <Binding Path="ItemCount" Mode="OneWay" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="SelectionBar" Background="Transparent" />
                                            <Border x:Name="ItemBackground" Grid.Column="1" Background="Transparent"
                                                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                                    CornerRadius="3" Padding="10">
                                                <ContentPresenter />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource Brush.SurfaceElevated}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionBar" Property="Background" Value="{StaticResource Brush.Accent}" />
                                                <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource Brush.AccentSubtleBg}" />
                                                <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{StaticResource Brush.AccentMuted}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}"
                                        CornerRadius="3" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource Text.Label}"
                                               Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Asset}" Style="{StaticResource Text.Body}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SubtitleText, Mode=OneWay}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Top" Margin="8,0,0,0"
                                        Style="{StaticResource Badge.Base}" Background="{StaticResource Brush.SurfaceAlt}">
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Badge.Text}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </Grid>

            <Grid Grid.Column="2">
                <Border Style="{StaticResource Surface.Card}" Padding="18"
                        Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loaded}">
                    <Grid>
                        <ScrollViewer x:Name="CaseDetails" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="{x:Type ScrollViewer}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCase}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel DataContext="{Binding SelectedCase}">
                                <TextBlock Text="{Binding Asset}" Style="{StaticResource Text.PageTitle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ActionUserDeviceText, Mode=OneWay}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,12" />

                                <WrapPanel Margin="0,0,0,12">
                                    <Border Height="22" Background="{Binding Classification, Converter={StaticResource ClassBrush}, ConverterParameter=Bg}"
                                            CornerRadius="3" Padding="8,0" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Classification}" Style="{StaticResource Text.Label}"
                                                   Foreground="{Binding Classification, Converter={StaticResource ClassBrush}}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border Height="22" Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}"
                                            CornerRadius="3" Padding="8,0" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource Text.Label}"
                                                   Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"
                                               Margin="0,0,12,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}detected {0}">
                                                <Binding Path="AgeText" Mode="OneWay" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Button Content="View activity for this asset" Height="26" Padding="8,2"
                                            FontSize="{StaticResource FontSize.Small}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.ViewActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Button Content="View this device" Height="26" Padding="8,2"
                                            FontSize="{StaticResource FontSize.Small}" Style="{StaticResource Button.Secondary}"
                                            Command="{Binding DataContext.ViewDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </WrapPanel>

                                <TextBlock Text="Status" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <RadioButton GroupName="CaseStatus" Content="New" Style="{StaticResource Segment.Item}" Margin="0,0,6,6"
                                                 IsChecked="{Binding Status, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:CaseStatus.New}, Mode=OneWay}"
                                                 Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{x:Static models:CaseStatus.New}" />
                                    <RadioButton GroupName="CaseStatus" Content="Investigating" Style="{StaticResource Segment.Item}" Margin="0,0,6,6"
                                                 IsChecked="{Binding Status, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:CaseStatus.Investigating}, Mode=OneWay}"
                                                 Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{x:Static models:CaseStatus.Investigating}" />
                                    <RadioButton GroupName="CaseStatus" Content="Resolved" Style="{StaticResource Segment.Item}" Margin="0,0,6,6"
                                                 IsChecked="{Binding Status, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:CaseStatus.Resolved}, Mode=OneWay}"
                                                 Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{x:Static models:CaseStatus.Resolved}" />
                                    <RadioButton GroupName="CaseStatus" Content="Dismissed" Style="{StaticResource Segment.Item}" Margin="0,0,6,6"
                                                 IsChecked="{Binding Status, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:CaseStatus.Dismissed}, Mode=OneWay}"
                                                 Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{x:Static models:CaseStatus.Dismissed}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding DataContext.StatusError, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Foreground="{StaticResource Brush.RiskCritical}" TextWrapping="Wrap"
                                           Visibility="{Binding DataContext.StatusError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringToVis}}" />

                                <StackPanel Margin="0,0,0,10" Visibility="{Binding IncidentId, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="Incident ID" Style="{StaticResource Text.Label}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding IncidentId}" Style="{StaticResource Text.Mono}" />
                                </StackPanel>
                                <TextBlock Text="Why it was flagged" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding RiskFactors}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="•" Margin="0,0,8,0" Foreground="{StaticResource Brush.Accent}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Investigation notes" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                                <TextBox Style="{StaticResource Input.TextBox}" MinHeight="84"
                                         Padding="10,8" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Tag="What did you check, and why are you closing this incident?"
                                         Text="{Binding DataContext.NotesDraft, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Resolution" Style="{StaticResource Text.Label}" Margin="0,10,0,6" />
                                <TextBox Style="{StaticResource Input.TextBox}" MinHeight="84"
                                         Padding="10,8" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding DataContext.ResolutionDraft, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Save notes" Style="{StaticResource Button.Primary}" Margin="0,0,8,8"
                                            Command="{Binding DataContext.SaveNotesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Button Content="Copy incident summary" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"
                                            Command="{Binding DataContext.CopySummaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </WrapPanel>

                                <TextBlock Text="{Binding DetectedAt, StringFormat='Detected {0:yyyy-MM-dd HH:mm}', Mode=OneWay}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding UpdatedAt, StringFormat='Last updated {0:yyyy-MM-dd HH:mm}', Mode=OneWay}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                                <TextBlock Margin="0,3,0,0" Text="{Binding DateResolvedText, StringFormat='Resolved {0}', Mode=OneWay}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Secondary}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DateResolved}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Text="Select an incident to review."
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Secondary}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCase}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Surface.Card}" Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loading}">
                    <TextBlock Text="Loading alerts…" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Style="{StaticResource Surface.Card}" Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Empty}">
                    <TextBlock Text="No alerts yet" Style="{StaticResource Text.Secondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Style="{StaticResource Surface.Card}" Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Error}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Unable to load Alerts" Style="{StaticResource Text.SectionHeading}" TextAlignment="Center" />
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Secondary}" TextAlignment="Center" Margin="0,8,0,12" />
                        <Button Content="Retry" Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
