<Window x:Class="ControlCenter.Views.CleanDataResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Maintenance Result"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="HeadingTextBlock" Text="Data Maintenance" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,8" />
            <TextBlock x:Name="StatusTextBlock"
                       Style="{StaticResource Text.Secondary}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14" />

            <Border Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,16">
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="OutputTextBlock"
                               Style="{StaticResource Text.Mono}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <Button Content="Close"
                    IsDefault="True"
                    IsCancel="True"
                    Style="{StaticResource Button.Primary}"
                    Height="34"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Border>
</Window>
