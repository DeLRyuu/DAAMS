<Window x:Class="ControlCenter.Views.PinPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin PIN Verification"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Background}">

    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Admin PIN Required" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,6" />
            <TextBlock x:Name="DescriptionTextBlock"
                       Text="Enter your 4 to 8 digit admin PIN to proceed."
                       Style="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <TextBlock Text="SECURITY PIN" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
            <PasswordBox x:Name="PinBox"
                         MaxLength="8"
                         Height="36"
                         Padding="8,6"
                         FontSize="14"
                         Background="#1E293B"
                         Foreground="#F8FAFC"
                         BorderBrush="{StaticResource Brush.BorderSubtle}"
                         BorderThickness="1"
                         Margin="0,0,0,8"
                         PasswordChanged="PinBox_PasswordChanged"
                         KeyDown="PinBox_KeyDown" />

            <TextBlock x:Name="ErrorTextBlock"
                       Text="Incorrect PIN"
                       Foreground="#EF4444"
                       Style="{StaticResource Text.Secondary}"
                       Visibility="Collapsed"
                       Margin="0,0,0,12" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource Button.Secondary}"
                        Height="34"
                        Click="CancelButton_Click" />

                <Button Grid.Column="2"
                        x:Name="ConfirmButton"
                        Content="Confirm"
                        IsDefault="True"
                        Style="{StaticResource Button.Primary}"
                        Height="34"
                        Click="ConfirmButton_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
