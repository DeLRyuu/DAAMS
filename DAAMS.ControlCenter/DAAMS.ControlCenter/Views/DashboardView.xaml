<UserControl x:Class="ControlCenter.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ControlCenter.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="720"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <conv:RiskLevelToBrushConverter x:Key="RiskBrush" />
        <conv:DataLoadStateToVisibilityConverter x:Key="LoadStateVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:IntToStarWidthConverter x:Key="StarWidth" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Layout.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Dashboard" Style="{StaticResource Text.PageTitle}" />
                <Border Background="{StaticResource Brush.RiskMediumBg}"
                        CornerRadius="3" Padding="7,2" Margin="12,4,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsShowingSampleFallback, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="SAMPLE DATA — FIRESTORE UNAVAILABLE" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.RiskMedium}" />
                </Border>
            </StackPanel>

            <Button Grid.Column="1" Content="Refresh" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" />
        </Grid>

        <!-- Content area: exactly one of these four is visible at a time -->
        <Grid Grid.Row="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loaded}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- PRIMARY SECURITY INSIGHT -->
                    <Border Grid.Row="0" Style="{StaticResource Surface.PrimaryCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="HIGH-RISK ACTIVITY" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.Accent}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding HighRiskActivities}" Style="{StaticResource Text.MetricLarge}" />
                                <TextBlock Text="activities scored High or Critical"
                                           Style="{StaticResource Text.Secondary}"
                                           Margin="12,0,0,10" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECONDARY METRICS -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface.Card}">
                            <StackPanel>
                                <TextBlock Text="PROTECTED ASSETS" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding TotalProtectedAssets}" Style="{StaticResource Text.Metric}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Surface.Card}">
                            <StackPanel>
                                <TextBlock Text="TOTAL ACTIVITY LOGS" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding TotalActivityLogs}" Style="{StaticResource Text.Metric}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource Surface.Card}">
                            <StackPanel>
                                <TextBlock Text="ACTIVE SECURITY ALERTS" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding ActiveSecurityAlerts}"
                                           Style="{StaticResource Text.Metric}"
                                           Foreground="{StaticResource Brush.RiskHigh}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource Surface.Card}">
                            <StackPanel>
                                <TextBlock Text="OPEN INCIDENTS" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding OpenIncidents}"
                                           Style="{StaticResource Text.Metric}"
                                           Foreground="{StaticResource Brush.StatusWarning}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- RISK DISTRIBUTION -->
                    <Border Grid.Row="2" Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Risk Distribution — Loaded Activity" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,12" />

                            <!-- Proportional stacked bar -->
                            <Grid Height="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding RiskLowCount, Converter={StaticResource StarWidth}}" />
                                    <ColumnDefinition Width="{Binding RiskMediumCount, Converter={StaticResource StarWidth}}" />
                                    <ColumnDefinition Width="{Binding RiskHighCount, Converter={StaticResource StarWidth}}" />
                                    <ColumnDefinition Width="{Binding RiskCriticalCount, Converter={StaticResource StarWidth}}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource Brush.RiskLow}" CornerRadius="2,0,0,2" />
                                <Border Grid.Column="1" Background="{StaticResource Brush.RiskMedium}" />
                                <Border Grid.Column="2" Background="{StaticResource Brush.RiskHigh}" />
                                <Border Grid.Column="3" Background="{StaticResource Brush.RiskCritical}" CornerRadius="0,2,2,0" />
                            </Grid>

                            <!-- Legend -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <Border Width="8" Height="8" Background="{StaticResource Brush.RiskLow}" CornerRadius="2" VerticalAlignment="Center" />
                                    <TextBlock Text="Low" Style="{StaticResource Text.Secondary}" Margin="6,0,4,0" />
                                    <TextBlock Text="{Binding RiskLowCount}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.TextPrimary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <Border Width="8" Height="8" Background="{StaticResource Brush.RiskMedium}" CornerRadius="2" VerticalAlignment="Center" />
                                    <TextBlock Text="Medium" Style="{StaticResource Text.Secondary}" Margin="6,0,4,0" />
                                    <TextBlock Text="{Binding RiskMediumCount}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.TextPrimary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <Border Width="8" Height="8" Background="{StaticResource Brush.RiskHigh}" CornerRadius="2" VerticalAlignment="Center" />
                                    <TextBlock Text="High" Style="{StaticResource Text.Secondary}" Margin="6,0,4,0" />
                                    <TextBlock Text="{Binding RiskHighCount}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.TextPrimary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" Background="{StaticResource Brush.RiskCritical}" CornerRadius="2" VerticalAlignment="Center" />
                                    <TextBlock Text="Critical" Style="{StaticResource Text.Secondary}" Margin="6,0,4,0" />
                                    <TextBlock Text="{Binding RiskCriticalCount}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.TextPrimary}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- RECENT ACTIVITY + RECENT ALERTS -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface.Card}">
                            <StackPanel>
                                <TextBlock Text="Recent Security Activity" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,10" />
                                <DataGrid ItemsSource="{Binding RecentActivity}" Style="{StaticResource Grid.Data}" MaxHeight="320">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="USER" Binding="{Binding User}" Width="*" />
                                        <DataGridTextColumn Header="ASSET" Binding="{Binding Asset}" Width="1.4*" />
                                        <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="*" />
                                        <DataGridTemplateColumn Header="RISK" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Badge.Base}"
                                                            Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}">
                                                        <TextBlock Text="{Binding RiskLevel}"
                                                                   Style="{StaticResource Badge.Text}"
                                                                   Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Surface.Card}">
                            <StackPanel>
                                <TextBlock Text="Recent Alerts" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding RecentAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush.BorderSubtle}"
                                                    BorderThickness="0,0,0,1" Padding="0,10">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Asset}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource Badge.Base}" Margin="8,0,0,0"
                                                                Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}">
                                                            <TextBlock Text="{Binding RiskLevel}"
                                                                       Style="{StaticResource Badge.Text}"
                                                                       Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reason}"
                                                               Style="{StaticResource Text.Secondary}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,0">
                                                        <Run Text="{Binding User, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Device, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loading}">
                <TextBlock Text="Loading dashboard data…" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Empty}">
                <TextBlock Text="Firestore is connected, but no DAAMS data has been recorded yet." Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Error}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="Unable to load Dashboard data" Style="{StaticResource Text.SectionHeading}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Retry" Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                        <Button Content="View Sample Data" Style="{StaticResource Button.Secondary}" Command="{Binding ShowSampleDataCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
