<UserControl x:Class="ControlCenter.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ControlCenter.Converters"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <conv:RiskLevelToBrushConverter x:Key="RiskBrush" />
        <conv:DataLoadStateToVisibilityConverter x:Key="LoadStateVis" />
        <conv:IntToStarWidthConverter x:Key="StarWidth" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Layout.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Dashboard" Style="{StaticResource Text.PageTitle}" />

            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loaded}">
                <StackPanel>
                    <Border Style="{StaticResource Surface.PrimaryCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,12">
                                <TextBlock Text="Needs review" Style="{StaticResource Text.SectionHeading}"
                                           DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding NeedsReviewCount}" DockPanel.Dock="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metric}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NeedsReviewCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding NeedsReviewCases}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}"
                                                    CornerRadius="3" Padding="7,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource Text.Label}"
                                                           Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Asset}" Style="{StaticResource Text.Body}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} by {1} on {2}, {3}">
                                                            <Binding Path="Action" Mode="OneWay" />
                                                            <Binding Path="User" Mode="OneWay" />
                                                            <Binding Path="Device" Mode="OneWay" />
                                                            <Binding Path="AgeText" Mode="OneWay" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="Open incident" Style="{StaticResource Button.Secondary}"
                                                    Command="{Binding DataContext.OpenCaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.Style>
                                    <Style TargetType="{x:Type ItemsControl}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>

                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NeedsReviewCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{StaticResource Brush.StatusPositive}" />
                                    <TextBlock Text="No alerts need review." Style="{StaticResource Text.Body}"
                                               Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding LatestHighRiskText}" Style="{StaticResource Text.Secondary}"
                                           Margin="18,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding LatestHighRiskText, Converter={StaticResource StringToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalProtectedAssets}" Style="{StaticResource Text.Metric}" />
                            <TextBlock Text="Protected assets" Style="{StaticResource Text.Secondary}" />
                        </StackPanel>
                        <Border Width="1" Height="32" Margin="20,0" Background="{StaticResource Brush.BorderSubtle}" />
                        <StackPanel>
                            <TextBlock Text="{Binding TotalActivityLogs, Mode=OneWay}" Style="{StaticResource Text.Metric}" />
                            <TextBlock Text="{Binding RangeLabel, Mode=OneWay, StringFormat='Activities ({0})'}" Style="{StaticResource Text.Secondary}" />
                        </StackPanel>
                        <Border Width="1" Height="32" Margin="20,0" Background="{StaticResource Brush.BorderSubtle}" />
                        <StackPanel>
                            <TextBlock Text="{Binding OpenCases}" Style="{StaticResource Text.Metric}" />
                            <TextBlock Text="Open incidents" Style="{StaticResource Text.Secondary}" />
                        </StackPanel>
                        <Border Width="1" Height="32" Margin="20,0" Background="{StaticResource Brush.BorderSubtle}" />
                        <StackPanel>
                            <TextBlock Text="{Binding DevicesReportingActivity}" Style="{StaticResource Text.Metric}" />
                            <TextBlock Text="{Binding RangeLabel, Mode=OneWay, StringFormat='Devices reporting activity ({0})'}" Style="{StaticResource Text.Secondary}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Risk mix" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,12" />
                            <Grid Height="8" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding RiskLowCount, Converter={StaticResource StarWidth}}" />
                                    <ColumnDefinition Width="{Binding RiskMediumCount, Converter={StaticResource StarWidth}}" />
                                    <ColumnDefinition Width="{Binding RiskHighCount, Converter={StaticResource StarWidth}}" />
                                    <ColumnDefinition Width="{Binding RiskCriticalCount, Converter={StaticResource StarWidth}}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource Brush.RiskLow}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RiskLowCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource Brush.RiskMedium}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RiskMediumCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource Brush.RiskHigh}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RiskHighCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Grid.Column="3" Background="{StaticResource Brush.RiskCritical}">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RiskCriticalCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                            <UniformGrid Columns="4" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.RiskLow}" VerticalAlignment="Center" />
                                    <TextBlock Text="Low" Style="{StaticResource Text.Secondary}" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding RiskLowCount}" Style="{StaticResource Text.Secondary}" Margin="5,0,0,0" />
                                    <TextBlock Text="{Binding RiskLowPercent, StringFormat=' ({0}%)'}" Style="{StaticResource Text.Secondary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.RiskMedium}" VerticalAlignment="Center" />
                                    <TextBlock Text="Medium" Style="{StaticResource Text.Secondary}" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding RiskMediumCount}" Style="{StaticResource Text.Secondary}" Margin="5,0,0,0" />
                                    <TextBlock Text="{Binding RiskMediumPercent, StringFormat=' ({0}%)'}" Style="{StaticResource Text.Secondary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.RiskHigh}" VerticalAlignment="Center" />
                                    <TextBlock Text="High" Style="{StaticResource Text.Secondary}" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding RiskHighCount}" Style="{StaticResource Text.Secondary}" Margin="5,0,0,0" />
                                    <TextBlock Text="{Binding RiskHighPercent, StringFormat=' ({0}%)'}" Style="{StaticResource Text.Secondary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.RiskCritical}" VerticalAlignment="Center" />
                                    <TextBlock Text="Critical" Style="{StaticResource Text.Secondary}" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding RiskCriticalCount}" Style="{StaticResource Text.Secondary}" Margin="5,0,0,0" />
                                    <TextBlock Text="{Binding RiskCriticalPercent, StringFormat=' ({0}%)'}" Style="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Surface.Card}">
                            <StackPanel>
                                <TextBlock Text="Activity by hour" Style="{StaticResource Text.SectionHeading}" />
                                <TextBlock Text="Last 30 days" Style="{StaticResource Text.Secondary}" Margin="0,3,0,10"
                                           Visibility="{Binding ShowThirtyDayHourRange, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding ActivityByHour}" Height="82">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Height="{Binding HeightPx}" VerticalAlignment="Bottom"
                                                        Width="8" CornerRadius="2" ToolTip="{Binding HourTooltip}">
                                                    <Border.Style>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="Background" Value="{StaticResource Brush.TextTertiary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWorkHour}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource Brush.AccentMuted}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{Binding Label}" Style="{StaticResource Text.Secondary}"
                                                           FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Surface.Card}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DevicesNeedingAttention.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Devices needing attention" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding DevicesNeedingAttention}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                                                    Padding="6" HorizontalContentAlignment="Stretch">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" />
                                                        <TextBlock Text="{Binding LastActivityText, StringFormat='Last activity {0}'}"
                                                                   Style="{StaticResource Text.Secondary}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding OpenCases, StringFormat='{}{0} open incidents'}"
                                                               Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Surface.Card}">
                        <StackPanel>
                            <TextBlock Text="Recent activity" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Time" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Device" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Asset" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Action" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Risk" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='MM-dd HH:mm:ss'}" Style="{StaticResource Text.Secondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Device}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Asset}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Action}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="4" HorizontalAlignment="Left"
                                                    Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}"
                                                    CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RiskLevel}" Style="{StaticResource Badge.Text}"
                                                           Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="View all in Activities" Command="{Binding ViewAllActivityCommand}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Foreground="{StaticResource Brush.Accent}" Cursor="Hand" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loading}">
                <TextBlock Text="Loading dashboard dataâ€¦" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Empty}">
                <TextBlock Text="No activities yet" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Error}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="Unable to load Dashboard data" Style="{StaticResource Text.SectionHeading}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Retry" Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
