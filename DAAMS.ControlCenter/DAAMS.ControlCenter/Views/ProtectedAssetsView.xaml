<UserControl x:Class="ControlCenter.Views.ProtectedAssetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ControlCenter.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="720"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <conv:ClassificationToBrushConverter x:Key="ClassBrush" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <conv:RiskLevelToBrushConverter x:Key="RiskBrush" />
        <conv:DataLoadStateToVisibilityConverter x:Key="LoadStateVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseDrawerCommand}" />
    </UserControl.InputBindings>

    <Grid Style="{StaticResource Layout.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Protected Assets" Style="{StaticResource Text.PageTitle}" />
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <TextBox Style="{StaticResource Input.TextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search by asset name or path…" />
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding ActionError}"
                   Style="{StaticResource Text.Secondary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding ActionError, Converter={StaticResource StringToVis}}" />

        <!-- Content area -->
        <Grid Grid.Row="3">

            <!-- Loaded State with DataGrid + Detail Drawer -->
            <Grid Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loaded}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- DataGrid Table -->
                <Border Grid.Column="0" Style="{StaticResource Surface.Card}" Padding="18,6,18,10">
                    <DataGrid ItemsSource="{Binding Assets}"
                              SelectedItem="{Binding SelectedAsset}"
                              SelectionMode="Single"
                              Style="{StaticResource Grid.Data}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Unprotected">
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding CloseDrawerCommand}" />
                            <MouseBinding Gesture="LeftDoubleClick"
                                          Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <!-- ASSET (name, ellipsis + ToolTip full path, and inactive note) -->
                            <DataGridTemplateColumn Header="Asset" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AssetName}"
                                                       Style="{StaticResource Text.Body}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}" />
                                            <TextBlock Text="{Binding ActivityNote}"
                                                       Style="{StaticResource Text.Secondary}"
                                                       FontSize="{StaticResource FontSize.Micro}"
                                                       Foreground="{StaticResource Brush.TextTertiary}"
                                                       Visibility="{Binding HasNoRecentActivity, Converter={StaticResource BoolToVis}}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Type" Binding="{Binding AssetType}" Width="0.8*" />

                            <DataGridTemplateColumn Header="Classification" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge.Base}"
                                                Background="{Binding Classification, Converter={StaticResource ClassBrush}, ConverterParameter=Bg}">
                                            <TextBlock Text="{Binding Classification}"
                                                       Style="{StaticResource Badge.Text}"
                                                       Foreground="{Binding Classification, Converter={StaticResource ClassBrush}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge.Base}"
                                                Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Bg}">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Badge.Text}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivityText}" Width="1.2*" />
                            <DataGridTextColumn Header="Activities" Binding="{Binding EventsInRange}" Width="1*" />

                            <DataGridTemplateColumn Header="Highest risk" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="RiskBadge" Style="{StaticResource Badge.Base}"
                                                    Background="{Binding HighestRisk, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}">
                                                <TextBlock Text="{Binding HighestRisk}"
                                                           Style="{StaticResource Badge.Text}"
                                                           Foreground="{Binding HighestRisk, Converter={StaticResource RiskBrush}}" />
                                            </Border>
                                            <TextBlock x:Name="NoneText" Text="None" Style="{StaticResource Text.Secondary}" Visibility="Collapsed" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HighestRisk}" Value="{x:Null}">
                                                <Setter TargetName="RiskBadge" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="NoneText" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Protected at" Binding="{Binding ProtectedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Detail Drawer (about 340px) -->
                <Border Grid.Column="1" Width="340" Margin="14,0,0,0"
                        Style="{StaticResource Surface.Card}" Padding="18"
                        Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Header: Title and Close -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedAsset.AssetName}"
                                           Style="{StaticResource Text.SectionHeading}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedAsset.AssetName}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="✕"
                                        Style="{StaticResource Button.Secondary}"
                                        Command="{Binding CloseDrawerCommand}"
                                        Padding="0" Height="26" Width="26"
                                        ToolTip="Close (Esc)" />
                            </Grid>

                            <!-- Full Path (Text.Mono, wrapped) -->
                            <TextBlock Text="Asset path" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedAsset.Path}"
                                       Style="{StaticResource Text.Mono}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14" />
                            <StackPanel Margin="0,0,0,14"
                                        Visibility="{Binding SelectedAsset.IsInherited, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Protected via folder" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedAsset.InheritedFrom}"
                                           Style="{StaticResource Text.Mono}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Classification & Base risk -->
                            <TextBlock Text="Classification" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource Badge.Base}"
                                        Background="{Binding SelectedAsset.Classification, Converter={StaticResource ClassBrush}, ConverterParameter=Bg}">
                                    <TextBlock Text="{Binding SelectedAsset.Classification}"
                                               Style="{StaticResource Badge.Text}"
                                               Foreground="{Binding SelectedAsset.Classification, Converter={StaticResource ClassBrush}}" />
                                </Border>
                            </StackPanel>

                            <!-- Protected by and Protected at -->
                            <TextBlock Text="Protection details" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Protected by:" Style="{StaticResource Text.Secondary}" Margin="0,0,10,4" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAsset.ProtectedBy}" Style="{StaticResource Text.Body}" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Protected at:" Style="{StaticResource Text.Secondary}" Margin="0,0,10,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAsset.ProtectedAt, StringFormat='yyyy-MM-dd HH:mm'}" Style="{StaticResource Text.Body}" Margin="0,0,0,4" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Type:" Style="{StaticResource Text.Secondary}" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAsset.AssetType}" Style="{StaticResource Text.Body}" />
                            </Grid>

                            <!-- Open cases count -->
                            <TextBlock Text="Open incidents" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding SelectedAsset.OpenCases, StringFormat='{}{0} active open incidents', Mode=OneWay}" Style="{StaticResource Text.Body}" Margin="0,0,0,14" />

                            <!-- Last 5 events (time, action, risk badge) -->
                            <TextBlock Text="Last 5 activities" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding RecentEvents}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="0,6,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}"
                                                           Style="{StaticResource Text.Secondary}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Action}"
                                                           Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Border Grid.Column="2" Style="{StaticResource Badge.Base}"
                                                        Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}">
                                                    <TextBlock Text="{Binding RiskLevel}"
                                                               Style="{StaticResource Badge.Text}"
                                                               Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No activities recorded" Margin="0,0,0,14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentEvents.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Action Buttons -->
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="View activity" Style="{StaticResource Button.Secondary}"
                                        Command="{Binding ViewActivityCommand}" Margin="0,0,8,8" />
                                <Button Content="View alerts" Style="{StaticResource Button.Secondary}"
                                        Command="{Binding ViewAlertsCommand}" Margin="0,0,8,8" />
                            </WrapPanel>

                            <!-- Protection Actions (PIN-gated) -->
                            <Border BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Change classification" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  Style="{StaticResource Input.ComboBox}"
                                                  ItemsSource="{Binding AvailableClassifications}"
                                                  SelectedItem="{Binding DrawerSelectedClassification, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsSelectedAssetProtected}" />
                                        <Button Grid.Column="2"
                                                Content="Change"
                                                Style="{StaticResource Button.Secondary}"
                                                Command="{Binding ChangeClassificationCommand}"
                                                IsEnabled="{Binding IsSelectedAssetProtected}" />
                                    </Grid>

                                    <TextBlock Text="Remove protection" Style="{StaticResource Text.Label}" Margin="0,0,0,4" />
                                    <Button Content="Remove protection"
                                            Style="{StaticResource Button.Secondary}"
                                            Command="{Binding RemoveProtectionCommand}"
                                            HorizontalAlignment="Left"
                                            IsEnabled="{Binding IsSelectedAssetProtected}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Loading State -->
            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loading}">
                <TextBlock Text="Loading protected assets…" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Empty State -->
            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Empty}">
                <TextBlock Text="No protected assets yet" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Error State -->
            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Error}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="Unable to load Protected Assets" Style="{StaticResource Text.SectionHeading}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Retry" Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
