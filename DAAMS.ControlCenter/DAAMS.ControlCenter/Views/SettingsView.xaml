<UserControl x:Class="ControlCenter.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ControlCenter.Converters"
             mc:Ignorable="d"
             d:DesignWidth="960" d:DesignHeight="1400"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="NumericField" TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}">
            <Setter Property="Width" Value="90" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Layout.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,16" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

            <!-- ==================== 1. SYSTEM INFORMATION ==================== -->
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="DAAMS Control Center 1.0 (prototype)" Style="{StaticResource Text.Body}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CloudStatusText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Refresh" Style="{StaticResource Button.Secondary}"
                                Command="{Binding RefreshCloudConnectionCommand}" Height="30" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 2. DISPLAY ==================== -->
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Display" Style="{StaticResource Text.SectionHeading}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SavedStatusText}" Style="{StaticResource Text.Secondary}"
                                   Foreground="{StaticResource Brush.StatusPositive}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding SavedStatusText, Converter={StaticResource StringToVis}}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto-refresh interval" Style="{StaticResource Text.Body}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="70" Height="32" Style="{StaticResource Input.TextBox}" Text="{Binding AutoRefreshIntervalInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue='30', FallbackValue='30'}" Tag="30" />
                            <TextBlock Text="seconds" Style="{StaticResource Text.Secondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Highlight Critical rows" Style="{StaticResource Text.Body}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding HighlightCriticalRows}" VerticalAlignment="Center" />
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ==================== 3. WORK HOURS ==================== -->
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Work hours" Style="{StaticResource Text.SectionHeading}" />
                            <TextBlock Text="{Binding CurrentWorkHoursText}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding WorkHoursSavedStatusText}" Style="{StaticResource Text.Secondary}"
                                   Foreground="{StaticResource Brush.StatusPositive}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding WorkHoursSavedStatusText, Converter={StaticResource StringToVis}}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start hour (0–24)" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Beginning of normal working hours (inclusive)" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="70" Height="32" Style="{StaticResource Input.TextBox}"
                                 Text="{Binding WorkStartHourInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="End hour (0–24)" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="End of normal working hours (exclusive)" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="70" Height="32" Style="{StaticResource Input.TextBox}"
                                 Text="{Binding WorkEndHourInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding WorkHoursValidationMessage}"
                               Foreground="{StaticResource Brush.RiskCritical}"
                               Style="{StaticResource Text.Secondary}"
                               Margin="0,0,0,10"
                               Visibility="{Binding WorkHoursValidationMessage, Converter={StaticResource StringToVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Save" Style="{StaticResource Button.Primary}"
                                Command="{Binding SaveWorkHoursCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 4. EMAIL ALERTS ==================== -->
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Email alerts" Style="{StaticResource Text.SectionHeading}" />
                            <TextBlock Text="{Binding EmailAlertsStatusLine}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding EmailSavedStatusText}" Style="{StaticResource Text.Secondary}"
                                   Foreground="{StaticResource Brush.StatusPositive}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding EmailSavedStatusText, Converter={StaticResource StringToVis}}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Recipient email" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Address where alert notifications are sent" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="220" Height="32" Style="{StaticResource Input.TextBox}"
                                 Text="{Binding NotificationEmailInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding EmailValidationMessage}"
                               Foreground="{StaticResource Brush.RiskCritical}"
                               Style="{StaticResource Text.Secondary}"
                               Margin="0,0,0,10"
                               Visibility="{Binding EmailValidationMessage, Converter={StaticResource StringToVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Save" Style="{StaticResource Button.Primary}"
                                Command="{Binding SaveNotificationEmailCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 5. SMTP CONFIGURATION ==================== -->
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SMTP configuration" Style="{StaticResource Text.SectionHeading}" />
                            <TextBlock Text="{Binding SmtpStatusLine}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SmtpSavedStatusText}" Style="{StaticResource Text.Secondary}"
                                   Foreground="{StaticResource Brush.StatusPositive}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding SmtpSavedStatusText, Converter={StaticResource StringToVis}}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sender email" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Email address used to send alert notifications" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Width="220" Height="32" Style="{StaticResource Input.TextBox}"
                                 Text="{Binding SmtpSenderEmailInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="App password" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Application password (stored encrypted on this device)" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <PasswordBox x:Name="SmtpPasswordBox" Grid.Column="1" Width="220" Height="32"
                                     Background="{StaticResource Brush.SurfaceAlt}"
                                     Foreground="{StaticResource Brush.TextPrimary}"
                                     BorderBrush="{StaticResource Brush.Border}"
                                     BorderThickness="1"
                                     Padding="8,4"
                                     FontSize="12"
                                     VerticalContentAlignment="Center" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Enabled" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Enable sending alert emails via SMTP (smtp.gmail.com:587)" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}"
                                  IsChecked="{Binding SmtpEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding SmtpValidationMessage}"
                               Foreground="{StaticResource Brush.RiskCritical}"
                               Style="{StaticResource Text.Secondary}"
                               Margin="0,0,0,10"
                               Visibility="{Binding SmtpValidationMessage, Converter={StaticResource StringToVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Save" Style="{StaticResource Button.Primary}"
                                Command="{Binding SaveSmtpSettingsCommand}"
                                CommandParameter="{Binding ElementName=SmtpPasswordBox}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 6. PASSKEY PIN ==================== -->
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Passkey PIN" Style="{StaticResource Text.SectionHeading}" />
                        <TextBlock Text="A random 4-digit PIN generated here and saved to Firestore. Monitoring Engines download it automatically and keep a local copy, so they still work offline. Generating a new one replaces the old one everywhere. Only a hash is stored in the cloud; the PIN itself can be shown only on the PC that generated it (kept encrypted for your Windows account)."
                                   Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Text="{Binding PasskeyStatusText}" Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Border Background="{StaticResource Brush.SurfaceAlt}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            Padding="16,12"
                            Margin="0,0,0,10"
                            Visibility="{Binding HasPasskeyToShow, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Current Passkey PIN" Style="{StaticResource Text.Secondary}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding PasskeyDisplayText}"
                                           FontSize="32" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource Button.Secondary}"
                                        Command="{Binding TogglePasskeyRevealCommand}"
                                        ToolTip="Show / hide the PIN"
                                        Width="44" Height="34" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding PasskeyEyeGlyph}"
                                               FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                </Button>
                                <Button Grid.Column="2" Content="Copy" Style="{StaticResource Button.Secondary}"
                                        Command="{Binding CopyPasskeyCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding PasskeyHiddenNote}"
                               Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding PasskeyHiddenNote, Converter={StaticResource StringToVis}}" />

                    <TextBlock Text="{Binding PasskeyMessage}"
                               Foreground="{StaticResource Brush.StatusPositive}"
                               Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding PasskeyMessage, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding PasskeyError}"
                               Foreground="{StaticResource Brush.RiskCritical}"
                               Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding PasskeyError, Converter={StaticResource StringToVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Generate new Passkey PIN" Style="{StaticResource Button.Primary}"
                                Command="{Binding GeneratePasskeyCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 7. NOTIFICATIONS ==================== -->
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Notifications" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,14" />

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Show a message when a new High or Critical alert arrives" Style="{StaticResource Text.Body}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding NotifyOnNewAlert}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Email alerts" Style="{StaticResource Text.Body}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding EmailAlertsSummaryText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ==================== 8. DATA MAINTENANCE ==================== -->
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Data Maintenance" Style="{StaticResource Text.SectionHeading}" />
                            <TextBlock Text="Clean test data and reset history for demonstration or fresh test runs" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding MaintenanceStatusText}" Style="{StaticResource Text.Secondary}"
                                   Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding MaintenanceStatusText, Converter={StaticResource StringToVis}}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Clean Local Data" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Clears local activity logs, security alerts, and incident reports."
                                       Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="This computer only, backup is made."
                                       Style="{StaticResource Text.Secondary}" FontStyle="Italic" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Requires DAAMS Monitoring Engine on this PC."
                                       Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding RequiresEngineForLocalCleanup, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Removes every protected asset and resets the PIN to default."
                                       Foreground="{StaticResource Brush.RiskCritical}"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource Text.Secondary}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding CleanLocalAll, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="Clean Local Data" Style="{StaticResource Button.Secondary}"
                                    Command="{Binding CleanLocalDataCommand}"
                                    IsEnabled="{Binding CanRunLocalMaintenance}"
                                    HorizontalAlignment="Right" />
                            <CheckBox Margin="0,8,0,0"
                                      IsChecked="{Binding CleanLocalAll, Mode=TwoWay}"
                                      IsEnabled="{Binding CanRunLocalMaintenance}"
                                      HorizontalAlignment="Right">
                                <TextBlock Text="Also delete protected assets and PIN settings (--all)"
                                           Foreground="{StaticResource Brush.RiskCritical}"
                                           FontSize="{StaticResource FontSize.Small}"
                                           VerticalAlignment="Center" />
                            </CheckBox>
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Clean Cloud Data" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Deletes test records from Firebase Firestore."
                                       Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Permanent, no backup."
                                       Style="{StaticResource Text.Secondary}" FontStyle="Italic" Margin="0,2,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Removes every protected asset and resets the PIN to default."
                                       Foreground="{StaticResource Brush.RiskCritical}"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource Text.Secondary}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding CleanCloudAll, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="Clean Cloud Data" Style="{StaticResource Button.Secondary}"
                                    Command="{Binding CleanCloudDataCommand}"
                                    IsEnabled="{Binding CanRunMaintenance}"
                                    HorizontalAlignment="Right" />
                            <CheckBox Margin="0,8,0,0"
                                      IsChecked="{Binding CleanCloudAll, Mode=TwoWay}"
                                      IsEnabled="{Binding CanRunMaintenance}"
                                      HorizontalAlignment="Right">
                                <TextBlock Text="Also delete protected assets and PIN settings (--all)"
                                           Foreground="{StaticResource Brush.RiskCritical}"
                                           FontSize="{StaticResource FontSize.Small}"
                                           VerticalAlignment="Center" />
                            </CheckBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding MaintenanceMessage}"
                               Foreground="{Binding MaintenanceMessageBrush}"
                               Style="{StaticResource Text.Secondary}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding MaintenanceMessage, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
