<UserControl x:Class="ControlCenter.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ControlCenter.Converters"
             mc:Ignorable="d"
             d:DesignWidth="960" d:DesignHeight="1400"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="NumericField" TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}">
            <Setter Property="Width" Value="90" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource Layout.PageRoot}">
            <TextBlock Text="Settings" Style="{StaticResource Text.PageTitle}" Margin="0,0,0,16" />

            <!-- ==================== 1. SYSTEM INFORMATION ==================== -->
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="System information" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,14" />

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Version" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Database path" Style="{StaticResource Text.Label}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DatabasePath}"
                                       Style="{StaticResource Text.Mono}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DatabasePath}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DatabaseStatusText}"
                                       Style="{StaticResource Text.Secondary}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Sync summary" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding SyncSummaryText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Last upload attempt" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding LastUploadAttemptText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Last event received" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding LastEventReceivedText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Firestore status" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding FirestoreConnectionStatus}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 2. DISPLAY ==================== -->
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Display" Style="{StaticResource Text.SectionHeading}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SavedStatusText}" Style="{StaticResource Text.Secondary}"
                                   Foreground="{StaticResource Brush.StatusPositive}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding SavedStatusText, Converter={StaticResource StringToVis}}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto-refresh interval" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Background refresh interval in seconds (10 to 300, 0 = off)."
                                       Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Style="{StaticResource NumericField}" Text="{Binding AutoRefreshIntervalInput, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="sec" Style="{StaticResource Text.Secondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default time range" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Time range applied at startup across activity logs and alerts."
                                       Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="140" VerticalAlignment="Center"
                                  ItemsSource="{Binding AvailableTimeRanges}"
                                  SelectedItem="{Binding DefaultTimeRange}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Highlight Critical rows" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Tint Critical-risk rows in Activity and Alerts." Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding HighlightCriticalRows}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Expand risk factors by default" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Sets RowDetailsVisibilityMode on the Activity grid to expanded." Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding ShowRiskFactorBreakdown}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 3. NOTIFICATIONS ==================== -->
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Notifications" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,14" />

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Show a message when a new High or Critical alert arrives" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Displays an in-app non-blocking toast notification." Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle.Switch}" IsChecked="{Binding NotifyOnNewAlert}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel>
                        <TextBlock Text="Email alerts" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="Email alerts are sent by the Monitoring System." Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 4. ENGINE DEFAULTS ==================== -->
            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Engine defaults" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,4" />
                    <TextBlock Text="Read-only baseline configuration enforced by the Monitoring and Risk Assessment Engine."
                               Style="{StaticResource Text.Secondary}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Working hours" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding WorkingHoursText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Off-hours penalty" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding OffHoursPenalty}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Near-edge caution" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding NearEdgeOfHoursCaution}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Burst threshold" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="{Binding BurstThresholdReference}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Classification weights" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding ClassificationWeightsText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Action weights" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding ActionWeightsText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Risk bands" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding RiskBandsText}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 5. NOT ACTIVE YET ==================== -->
            <Expander Header="Not active yet" IsExpanded="False" Margin="0,0,0,16">
                <StackPanel IsEnabled="False" Opacity="0.55" Margin="0,10,0,0">
                    <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Configuration actions" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" Command="{Binding CancelChangesCommand}" />
                                <Button Content="Reset to Defaults" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" Command="{Binding ResetToDefaultsCommand}" />
                                <Button Content="Save Changes" Style="{StaticResource Button.Primary}" Command="{Binding SaveChangesCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Monitoring configuration" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding MonitoringStatusText}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Toggle.Switch}" Content="Monitoring" IsChecked="{Binding MonitoringEnabled}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Interval:" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Style="{StaticResource NumericField}" Text="{Binding MonitoringIntervalInput}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Risk assessment configuration" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,4" />
                            <Grid Style="{StaticResource SettingRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Medium threshold" Style="{StaticResource Text.Label}" />
                                    <TextBox Style="{StaticResource NumericField}" Margin="0,4,0,0" Text="{Binding MediumThresholdInput}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="High threshold" Style="{StaticResource Text.Label}" />
                                    <TextBox Style="{StaticResource NumericField}" Margin="0,4,0,0" Text="{Binding HighThresholdInput}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Critical threshold" Style="{StaticResource Text.Label}" />
                                    <TextBox Style="{StaticResource NumericField}" Margin="0,4,0,0" Text="{Binding CriticalThresholdInput}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Burst threshold:" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Style="{StaticResource NumericField}" Text="{Binding BurstThresholdInput}" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Toggle.Switch}" Content="Off-hours risk weighting" IsChecked="{Binding OffHoursMonitoringEnabled}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Surface.Card}">
                        <StackPanel>
                            <TextBlock Text="Other preferences" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Toggle.Switch}" Content="Start Control Center with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Toggle.Switch}" Content="Show Sample Data banner" IsChecked="{Binding ShowSampleDataBanner}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Toggle.Switch}" Content="Email notifications" IsChecked="{Binding EmailNotificationsEnabled}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox Style="{StaticResource Toggle.Switch}" Content="High risk" IsChecked="{Binding NotifyOnHighRisk}" Margin="0,0,16,0" />
                                <CheckBox Style="{StaticResource Toggle.Switch}" Content="Critical risk" IsChecked="{Binding NotifyOnCriticalRisk}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
