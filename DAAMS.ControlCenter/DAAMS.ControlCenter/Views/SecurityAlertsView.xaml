<UserControl x:Class="ControlCenter.Views.SecurityAlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ControlCenter.Converters"
             xmlns:models="clr-namespace:ControlCenter.Models"
             mc:Ignorable="d"
             d:DesignWidth="1150" d:DesignHeight="800"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <conv:RiskLevelToBrushConverter x:Key="RiskBrush" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <conv:ClassificationToBrushConverter x:Key="ClassBrush" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:DataLoadStateToVisibilityConverter x:Key="LoadStateVis" />
        <conv:StatusMatchToBrushConverter x:Key="StatusMatch" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Layout.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Security Alerts" Style="{StaticResource Text.PageTitle}" />
        </Grid>

        <!-- Interpretation note — keeps alerts from reading as accusations -->
        <Border Grid.Row="1" Style="{StaticResource Surface.Card}" Margin="0,10,0,0" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="3" CornerRadius="2" Background="{StaticResource Brush.Border}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" MaxWidth="760">
                    An alert flags activity that scored High or Critical risk and warrants a closer look — it is not proof of
                    malicious behavior. Select an alert below to review why it was flagged, update its status, and
                    optionally open an Incident Report to document what you find.
                </TextBlock>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="2" Margin="0,16,0,14">
            <TextBox Style="{StaticResource Input.TextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search by alert ID, user, device, or asset…" />
        </Grid>

        <!-- Content area: exactly one of these four is visible at a time -->
        <Grid Grid.Row="3">

            <Border Style="{StaticResource Surface.Card}" Padding="18,6,18,10"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loaded}">
                <DataGrid ItemsSource="{Binding Alerts}" Style="{StaticResource Grid.Data}"
                          SelectedItem="{Binding SelectedAlert}"
                          RowDetailsVisibilityMode="VisibleWhenSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Alert ID" Binding="{Binding AlertId}" Width="1.1*" />
                        <DataGridTextColumn Header="User" Binding="{Binding User}" Width="*" />
                        <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="*" />
                        <DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="1.2*" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="0.8*" />

                        <DataGridTemplateColumn Header="Risk" Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Badge.Base}"
                                                Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}">
                                            <TextBlock Text="{Binding RiskLevel}"
                                                       Style="{StaticResource Badge.Text}"
                                                       Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}" />
                                        </Border>
                                        
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Date / time" Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="1.1*" />

                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge.Base}"
                                            Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Bg}">
                                        <TextBlock Text="{Binding Status}"
                                                   Style="{StaticResource Badge.Text}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!-- Selecting a row reveals full details + the investigation panel. -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="3" Padding="16,14" Margin="0,4,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT: full details + why -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Alert details" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                                <TextBlock Text="Asset path" Style="{StaticResource Text.Label}" />
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Mono}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                                <TextBlock Text="Classification" Style="{StaticResource Text.Label}" />
                                                <Border Style="{StaticResource Badge.Base}" Margin="0,4,0,0"
                                                        Background="{Binding Classification, Converter={StaticResource ClassBrush}, ConverterParameter=Bg}">
                                                    <TextBlock Text="{Binding Classification}"
                                                               Style="{StaticResource Badge.Text}"
                                                               Foreground="{Binding Classification, Converter={StaticResource ClassBrush}}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Why this was flagged" Style="{StaticResource Text.Label}" Margin="0,4,0,6" />
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- RIGHT: investigation panel -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Investigation" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />

                                        <TextBlock Text="Update status" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <Button Content="New" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{x:Static models:AlertStatus.New}">
                                                <Button.Foreground>
                                                    <MultiBinding Converter="{StaticResource StatusMatch}">
                                                        <Binding Path="DataContext.SelectedAlert.Status" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        <Binding RelativeSource="{RelativeSource Self}" Path="CommandParameter" />
                                                    </MultiBinding>
                                                </Button.Foreground>
                                            </Button>
                                            <Button Content="Investigating" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{x:Static models:AlertStatus.Investigating}">
                                                <Button.Foreground>
                                                    <MultiBinding Converter="{StaticResource StatusMatch}">
                                                        <Binding Path="DataContext.SelectedAlert.Status" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        <Binding RelativeSource="{RelativeSource Self}" Path="CommandParameter" />
                                                    </MultiBinding>
                                                </Button.Foreground>
                                            </Button>
                                            <Button Content="Reviewed" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{x:Static models:AlertStatus.Reviewed}">
                                                <Button.Foreground>
                                                    <MultiBinding Converter="{StaticResource StatusMatch}">
                                                        <Binding Path="DataContext.SelectedAlert.Status" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        <Binding RelativeSource="{RelativeSource Self}" Path="CommandParameter" />
                                                    </MultiBinding>
                                                </Button.Foreground>
                                            </Button>
                                            <Button Content="Resolved" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{x:Static models:AlertStatus.Resolved}">
                                                <Button.Foreground>
                                                    <MultiBinding Converter="{StaticResource StatusMatch}">
                                                        <Binding Path="DataContext.SelectedAlert.Status" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        <Binding RelativeSource="{RelativeSource Self}" Path="CommandParameter" />
                                                    </MultiBinding>
                                                </Button.Foreground>
                                            </Button>
                                        </WrapPanel>

                                        <TextBlock Text="Investigation notes (used when creating an incident report)"
                                                   Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" TextWrapping="Wrap" />
                                        <TextBox Style="{StaticResource Input.TextBox}"
                                                 Text="{Binding DataContext.NewIncidentNotes, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="What did you find? (optional)"
                                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" />

                                        <Button Content="Create Incident Report" Style="{StaticResource Button.Primary}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.CreateIncidentReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loading}">
                <TextBlock Text="Loading security alerts…" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Empty}">
                <TextBlock Text="No security alerts yet" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Error}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="Unable to load Security Alerts" Style="{StaticResource Text.SectionHeading}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
                    <Button Content="Retry" Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
