<UserControl x:Class="ControlCenter.Views.SecurityAlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ControlCenter.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="760"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <conv:RiskLevelToBrushConverter x:Key="RiskBrush" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <conv:DataLoadStateToVisibilityConverter x:Key="LoadStateVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Layout.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Security Alerts" Style="{StaticResource Text.PageTitle}" />
                <Border Background="{StaticResource Brush.RiskMediumBg}"
                        CornerRadius="3" Padding="7,2" Margin="12,4,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsShowingSampleFallback, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="SAMPLE DATA — FIRESTORE UNAVAILABLE" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.RiskMedium}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="Refresh" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" />
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0">
                    <Run Text="{Binding NeedsAttentionCount, Mode=OneWay}" />
                    <Run Text=" of " />
                    <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text=" need attention" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Interpretation note — keeps alerts from reading as accusations -->
        <TextBlock Grid.Row="1" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="720">
            An alert flags activity that scored High or Critical risk and warrants a closer look —
            it is not proof of malicious behavior. Use Incident Reports to document what you find.
        </TextBlock>

        <!-- Toolbar -->
        <Grid Grid.Row="2" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Style="{StaticResource Input.TextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search by alert ID, user, device, or asset…" />

            <ComboBox Grid.Column="2" Style="{StaticResource Input.ComboBox}"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}"
                      DisplayMemberPath="Label" />

            <ComboBox Grid.Column="4" Style="{StaticResource Input.ComboBox}"
                      ItemsSource="{Binding RiskLevelOptions}"
                      SelectedItem="{Binding SelectedRiskLevel}"
                      DisplayMemberPath="Label" />
        </Grid>

        <!-- Content area: exactly one of these four is visible at a time -->
        <Grid Grid.Row="3">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loaded}">
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AlertId}" Style="{StaticResource Text.Mono}" />
                                            <Border Style="{StaticResource Badge.Base}" Margin="10,0,0,0"
                                                    Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}">
                                                <TextBlock Text="{Binding RiskLevel}"
                                                           Style="{StaticResource Badge.Text}"
                                                           Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}" />
                                            </Border>
                                            <TextBlock Text="{Binding RiskScore}" Style="{StaticResource Text.Secondary}" Margin="6,0,0,0" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Asset}" Style="{StaticResource Text.SectionHeading}" Margin="0,8,0,2" />
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,8" MaxWidth="620" />

                                        <TextBlock Style="{StaticResource Text.Secondary}">
                                            <Run Text="{Binding User, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Device, Mode=OneWay}" />
                                            <Run Text=" · Action: " />
                                            <Run Text="{Binding Action, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding CreatedAt, Mode=OneWay, StringFormat='yyyy-MM-dd HH:mm'}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource Badge.Base}"
                                                Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Bg}">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{StaticResource Badge.Text}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loading}">
                <TextBlock Text="Loading security alerts…" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Empty}">
                <TextBlock Text="No security alerts in Firestore. That's a good sign." Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Error}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="Unable to load Security Alerts" Style="{StaticResource Text.SectionHeading}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Retry" Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                        <Button Content="View Sample Data" Style="{StaticResource Button.Secondary}" Command="{Binding ShowSampleDataCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
