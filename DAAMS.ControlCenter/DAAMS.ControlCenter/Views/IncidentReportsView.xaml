<UserControl x:Class="ControlCenter.Views.IncidentReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ControlCenter.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1150" d:DesignHeight="760"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <conv:RiskLevelToBrushConverter x:Key="RiskBrush" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Layout.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Incident Reports" Style="{StaticResource Text.PageTitle}" />
            <Border Background="{StaticResource Brush.SurfaceElevated}"
                    CornerRadius="3" Padding="7,2" Margin="12,4,0,0" VerticalAlignment="Center"
                    Visibility="{Binding IsSampleData, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="SAMPLE DATA" Style="{StaticResource Text.Label}" />
            </Border>
        </StackPanel>
        <TextBlock Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Text.Secondary}">
            <Run Text="{Binding OpenCount, Mode=OneWay}" />
            <Run Text=" of " />
            <Run Text="{Binding TotalCount, Mode=OneWay}" />
            <Run Text=" incidents open" />
        </TextBlock>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Style="{StaticResource Input.TextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search by incident ID, user, asset, or description…" />

            <ComboBox Grid.Column="2" Style="{StaticResource Input.ComboBox}"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}"
                      DisplayMemberPath="Label" />
        </Grid>

        <!-- Incident cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Incidents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Surface.Card}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IncidentId}" Style="{StaticResource Text.Mono}" />
                                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="10,0,0,0"
                                                   Visibility="{Binding RelatedAlertId, Converter={StaticResource StringToVis}}">
                                            <Run Text="Related alert: " />
                                            <Run Text="{Binding RelatedAlertId, Mode=OneWay}" />
                                        </TextBlock>
                                        <Border Style="{StaticResource Badge.Base}" Margin="10,0,0,0"
                                                Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}">
                                            <TextBlock Text="{Binding RiskLevel}"
                                                       Style="{StaticResource Badge.Text}"
                                                       Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Asset}" Style="{StaticResource Text.SectionHeading}" Margin="0,8,0,2" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,8" MaxWidth="640" />

                                    <TextBlock Style="{StaticResource Text.Secondary}">
                                        <Run Text="{Binding User, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Device, Mode=OneWay}" />
                                        <Run Text=" · Action: " />
                                        <Run Text="{Binding Action, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Timestamp, Mode=OneWay, StringFormat='yyyy-MM-dd HH:mm'}" />
                                    </TextBlock>

                                    <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="640"
                                               Visibility="{Binding Notes, Converter={StaticResource StringToVis}}">
                                        <Run Text="Notes: " FontWeight="SemiBold" />
                                        <Run Text="{Binding Notes, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <Border Style="{StaticResource Badge.Base}"
                                            Background="{Binding InvestigationStatus, Converter={StaticResource StatusBrush}, ConverterParameter=Bg}">
                                        <TextBlock Text="{Binding InvestigationStatus}"
                                                   Style="{StaticResource Badge.Text}"
                                                   Foreground="{Binding InvestigationStatus, Converter={StaticResource StatusBrush}}" />
                                    </Border>
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat='Updated {0:yyyy-MM-dd HH:mm}'}"
                                               Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
