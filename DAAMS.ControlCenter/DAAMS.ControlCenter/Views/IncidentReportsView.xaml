<UserControl x:Class="ControlCenter.Views.IncidentReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ControlCenter.Converters"
             xmlns:models="clr-namespace:ControlCenter.Models"
             mc:Ignorable="d"
             d:DesignWidth="1150" d:DesignHeight="800"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <conv:RiskLevelToBrushConverter x:Key="RiskBrush" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <conv:ClassificationToBrushConverter x:Key="ClassBrush" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <conv:DataLoadStateToVisibilityConverter x:Key="LoadStateVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Layout.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Incident Reports" Style="{StaticResource Text.PageTitle}" />
                <Border Background="{StaticResource Brush.RiskMediumBg}"
                        CornerRadius="3" Padding="7,2" Margin="12,4,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsShowingSampleFallback, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="SAMPLE DATA — FIRESTORE UNAVAILABLE" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.RiskMedium}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="Refresh" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" />
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0">
                    <Run Text="{Binding OpenCount, Mode=OneWay}" />
                    <Run Text=" of " />
                    <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text=" open" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Style="{StaticResource Input.TextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search by incident ID, user, asset, or description…" />

            <ComboBox Grid.Column="2" Style="{StaticResource Input.ComboBox}"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}"
                      DisplayMemberPath="Label" />

            <ComboBox Grid.Column="4" Style="{StaticResource Input.ComboBox}"
                      ItemsSource="{Binding RiskLevelOptions}"
                      SelectedItem="{Binding SelectedRiskLevel}"
                      DisplayMemberPath="Label" />
        </Grid>

        <!-- Content area: exactly one of these four is visible at a time -->
        <Grid Grid.Row="2">

            <Border Style="{StaticResource Surface.Card}" Padding="18,6,18,10"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loaded}">
                <DataGrid ItemsSource="{Binding Incidents}" Style="{StaticResource Grid.Data}"
                          SelectedItem="{Binding SelectedIncident}"
                          RowDetailsVisibilityMode="VisibleWhenSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INCIDENT ID" Binding="{Binding IncidentId}" Width="1.1*" />
                        <DataGridTextColumn Header="ALERT ID" Binding="{Binding RelatedAlertId}" Width="*" />
                        <DataGridTextColumn Header="USER" Binding="{Binding User}" Width="*" />
                        <DataGridTextColumn Header="ASSET" Binding="{Binding Asset}" Width="1.2*" />

                        <DataGridTemplateColumn Header="RISK LEVEL" Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge.Base}"
                                            Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}">
                                        <TextBlock Text="{Binding RiskLevel}"
                                                   Style="{StaticResource Badge.Text}"
                                                   Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="DATE / TIME" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}" Width="1.1*" />

                        <DataGridTemplateColumn Header="STATUS" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge.Base}"
                                            Background="{Binding InvestigationStatus, Converter={StaticResource StatusBrush}, ConverterParameter=Bg}">
                                        <TextBlock Text="{Binding InvestigationStatus}"
                                                   Style="{StaticResource Badge.Text}"
                                                   Foreground="{Binding InvestigationStatus, Converter={StaticResource StatusBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="DATE RESOLVED" Binding="{Binding DateResolved, StringFormat='yyyy-MM-dd HH:mm'}" Width="1.1*" />
                    </DataGrid.Columns>

                    <!-- Selecting a row reveals full details + the resolution workflow. -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="3" Padding="16,14" Margin="0,4,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT: full details -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="INCIDENT DETAILS" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="DEVICE" Style="{StaticResource Text.Label}" />
                                                <TextBlock Text="{Binding Device}" Style="{StaticResource Text.Body}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="ACTION" Style="{StaticResource Text.Label}" />
                                                <TextBlock Text="{Binding Action}" Style="{StaticResource Text.Body}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="CLASSIFICATION" Style="{StaticResource Text.Label}" />
                                            <Border Style="{StaticResource Badge.Base}" Margin="0,4,0,0"
                                                    Background="{Binding Classification, Converter={StaticResource ClassBrush}, ConverterParameter=Bg}">
                                                <TextBlock Text="{Binding Classification}"
                                                           Style="{StaticResource Badge.Text}"
                                                           Foreground="{Binding Classification, Converter={StaticResource ClassBrush}}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="DESCRIPTION" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                        <StackPanel Visibility="{Binding Notes, Converter={StaticResource StringToVis}}">
                                            <TextBlock Text="INVESTIGATION NOTES" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding Notes}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- RIGHT: resolution workflow -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RESOLUTION WORKFLOW" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />

                                        <TextBlock Text="Update status" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <Button Content="New" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{x:Static models:InvestigationStatus.New}" />
                                            <Button Content="Under Investigation" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{x:Static models:InvestigationStatus.UnderInvestigation}" />
                                            <Button Content="Resolved" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{x:Static models:InvestigationStatus.Resolved}" />
                                            <Button Content="Dismissed" Style="{StaticResource Button.Secondary}" Margin="0,0,6,6"
                                                    Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{x:Static models:InvestigationStatus.Dismissed}" />
                                        </WrapPanel>
                                        <TextBlock Text="Marking Resolved or Dismissed records today's date as Date Resolved."
                                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                        <TextBlock Text="Resolution" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                                        <TextBox Style="{StaticResource Input.TextBox}"
                                                 Text="{Binding DataContext.ResolutionDraft, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="What was found / concluded?"
                                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" />

                                        <Button Content="Save Resolution" Style="{StaticResource Button.Primary}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.SaveResolutionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loading}">
                <TextBlock Text="Loading incident reports…" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Empty}">
                <TextBlock Text="No incident reports in Firestore yet." Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Error}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="Unable to load Incident Reports" Style="{StaticResource Text.SectionHeading}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Retry" Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                        <Button Content="View Sample Data" Style="{StaticResource Button.Secondary}" Command="{Binding ShowSampleDataCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
