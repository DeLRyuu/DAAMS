<UserControl x:Class="ControlCenter.Views.ActivityLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ControlCenter.Converters"
             xmlns:vm="clr-namespace:ControlCenter.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1150" d:DesignHeight="760"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <conv:RiskLevelToBrushConverter x:Key="RiskBrush" />
        <conv:ClassificationToBrushConverter x:Key="ClassBrush" />
        <conv:DataLoadStateToVisibilityConverter x:Key="LoadStateVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:DateToDayGroupConverter x:Key="DateToDayGroupConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Layout.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Activities" Style="{StaticResource Text.PageTitle}" />
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Style="{StaticResource Input.TextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search user, device, asset or action" />

            <Button Grid.Column="2" Content="Reset" Style="{StaticResource Button.Secondary}"
                    Command="{Binding ResetFiltersCommand}" />

            <Button Grid.Column="4" Content="Export CSV" Style="{StaticResource Button.Secondary}"
                    Command="{Binding ExportCsvCommand}" />
        </Grid>

        <!-- Content area: exactly one of these four is visible at a time -->
        <Grid Grid.Row="2">

            <Border Style="{StaticResource Surface.Card}" Padding="18,6,18,10"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loaded}">
                <DataGrid ItemsSource="{Binding Activity}" Style="{StaticResource Grid.Data}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          RowDetailsVisibilityMode="{Binding RowDetailsVisibilityMode}">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <DataGridRowsPresenter />
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.SurfaceAlt}" BorderThickness="0,0,0,1" Margin="0,10,0,4" Padding="0,0,0,4">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource DateToDayGroupConverter}}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.TextSecondary}" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}" Width="1.2*"
                                            SortMemberPath="Timestamp" SortDirection="Descending" />

                        <DataGridTextColumn Header="User" Binding="{Binding User}" Width="*" SortMemberPath="User" />

                        <DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="1.6*" SortMemberPath="Asset">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Path}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Action" Width="1*" SortMemberPath="Action">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Action}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RepeatCountDisplay}"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRepeats}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Risk" Width="1*" SortMemberPath="RiskLevel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge.Base}"
                                            HorizontalAlignment="Left"
                                            Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}">
                                        <TextBlock Text="{Binding RiskLevel}"
                                                   Style="{StaticResource Badge.Text}"
                                                   Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="3" Padding="14,10" Margin="0,4,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Device" Style="{StaticResource Text.Label}" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding Device}" Style="{StaticResource Text.Body}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Classification" Style="{StaticResource Text.Label}" Margin="0,0,0,2" />
                                            <Border Style="{StaticResource Badge.Base}" HorizontalAlignment="Left"
                                                    Background="{Binding Classification, Converter={StaticResource ClassBrush}, ConverterParameter=Bg}">
                                                <TextBlock Text="{Binding Classification}"
                                                           Style="{StaticResource Badge.Text}"
                                                           Foreground="{Binding Classification, Converter={StaticResource ClassBrush}}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Asset path" Style="{StaticResource Text.Label}" Margin="0,0,0,2" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Mono}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Navigation Actions -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="Open incident" Style="{StaticResource Button.Secondary}"
                                                Command="{Binding DataContext.OpenCaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasMatchingCase, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,8,0" />
                                        <Button Content="View device" Style="{StaticResource Button.Secondary}"
                                                Command="{Binding DataContext.ViewDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Device}" />
                                    </StackPanel>

                                    <TextBlock Text="Risk factors" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding RiskFactors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="•" Margin="0,0,8,0" Foreground="{StaticResource Brush.Accent}" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Collapsed Repeats: list all merged timestamps -->
                                    <StackPanel Visibility="{Binding HasDistinctMergedTimestamps, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                        <TextBlock Text="Merged timestamps" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding MergedTimestamps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='yyyy-MM-dd HH:mm:ss'}" Style="{StaticResource Text.Mono}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loading}">
                <TextBlock Text="Loading activities…" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Empty}">
                <TextBlock Text="No activities yet" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Error}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="Unable to load Activities" Style="{StaticResource Text.SectionHeading}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Retry" Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>