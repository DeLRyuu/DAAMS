<UserControl x:Class="ControlCenter.Views.ActivityLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:ControlCenter.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1150" d:DesignHeight="760"
             Background="{StaticResource Brush.Background}">

    <UserControl.Resources>
        <conv:RiskLevelToBrushConverter x:Key="RiskBrush" />
        <conv:ClassificationToBrushConverter x:Key="ClassBrush" />
        <conv:DataLoadStateToVisibilityConverter x:Key="LoadStateVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Style="{StaticResource Layout.PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Activity Logs" Style="{StaticResource Text.PageTitle}" />
                <Border Background="{StaticResource Brush.RiskMediumBg}"
                        CornerRadius="3" Padding="7,2" Margin="12,4,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsShowingSampleFallback, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="SAMPLE DATA — FIRESTORE UNAVAILABLE" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.RiskMedium}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="Refresh" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" />
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0">
                    <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text=" detected activities" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Style="{StaticResource Input.TextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search by user, device, or asset…" />

            <ComboBox Grid.Column="2" Style="{StaticResource Input.ComboBox}"
                      ItemsSource="{Binding ActionOptions}"
                      SelectedItem="{Binding SelectedAction}"
                      DisplayMemberPath="Label" />

            <ComboBox Grid.Column="4" Style="{StaticResource Input.ComboBox}"
                      ItemsSource="{Binding RiskLevelOptions}"
                      SelectedItem="{Binding SelectedRiskLevel}"
                      DisplayMemberPath="Label" />
        </Grid>

        <!-- Content area: exactly one of these four is visible at a time -->
        <Grid Grid.Row="2">

            <Border Style="{StaticResource Surface.Card}" Padding="18,6,18,10"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loaded}">
                <DataGrid ItemsSource="{Binding Activity}" Style="{StaticResource Grid.Data}"
                          RowDetailsVisibilityMode="VisibleWhenSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TIMESTAMP" Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}" Width="1.1*" />
                        <DataGridTextColumn Header="USER" Binding="{Binding User}" Width="*" />
                        <DataGridTextColumn Header="DEVICE" Binding="{Binding Device}" Width="*" />
                        <DataGridTextColumn Header="ASSET" Binding="{Binding Asset}" Width="1.2*" />
                        <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="0.8*" />

                        <DataGridTemplateColumn Header="CLASSIFICATION" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge.Base}"
                                            Background="{Binding Classification, Converter={StaticResource ClassBrush}, ConverterParameter=Bg}">
                                        <TextBlock Text="{Binding Classification}"
                                                   Style="{StaticResource Badge.Text}"
                                                   Foreground="{Binding Classification, Converter={StaticResource ClassBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="RISK" Width="0.9*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Badge.Base}"
                                                Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}, ConverterParameter=Bg}">
                                            <TextBlock Text="{Binding RiskLevel}"
                                                       Style="{StaticResource Badge.Text}"
                                                       Foreground="{Binding RiskLevel, Converter={StaticResource RiskBrush}}" />
                                        </Border>
                                        <TextBlock Text="{Binding RiskScore}" Style="{StaticResource Text.Secondary}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!-- Selecting a row reveals its risk factor breakdown — keeps the
                         default table scannable while still surfacing the "why" on demand. -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="3" Padding="14,10" Margin="0,4,0,8">
                                <StackPanel>
                                    <TextBlock Text="RISK FACTORS" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding RiskFactors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{Binding Weight, StringFormat='+{0}'}"
                                                               Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Accent}" Width="36" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Loading}">
                <TextBlock Text="Loading activity logs…" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Empty}">
                <TextBlock Text="No activity has been recorded in Firestore yet." Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border Style="{StaticResource Surface.Card}"
                    Visibility="{Binding LoadState, Converter={StaticResource LoadStateVis}, ConverterParameter=Error}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="Unable to load Activity Logs" Style="{StaticResource Text.SectionHeading}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Retry" Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                        <Button Content="View Sample Data" Style="{StaticResource Button.Secondary}" Command="{Binding ShowSampleDataCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
