<Window x:Class="ControlCenter.Views.CleanDataConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Data Cleanup"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Primary}">

    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="HeadingTextBlock" Text="Confirm Data Cleanup" Style="{StaticResource Text.SectionHeading}" Margin="0,0,0,8" />
            
            <TextBlock x:Name="DescriptionTextBlock"
                       Text="Activity logs, security alerts and incident reports will be deleted; protected assets and PIN are kept."
                       Style="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <!-- Red warning when ALL mode is selected -->
            <TextBlock x:Name="AllWarningTextBlock"
                       Text="Protected assets and PIN settings will ALSO be deleted and reset to default."
                       Foreground="{StaticResource Brush.RiskCritical}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,8" />

            <!-- Note / Scope -->
            <TextBlock x:Name="NoteTextBlock"
                       Style="{StaticResource Text.Secondary}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14" />

            <!-- Dry run output area (Visible for Cloud only) -->
            <StackPanel x:Name="DryRunPanel" Visibility="Collapsed" Margin="0,0,0,14">
                <TextBlock Text="Cloud Summary (Dry Run)" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                <Border Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="10">
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DryRunOutputTextBlock"
                                   Style="{StaticResource Text.Mono}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Phrase Confirmation Area (Visible for Cloud or Local ALL mode) -->
            <StackPanel x:Name="PhraseConfirmationPanel" Visibility="Collapsed" Margin="0,0,0,16">
                <TextBlock x:Name="PhrasePromptTextBlock" Text="To confirm, type DELETE CLOUD DATA below:" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                <TextBox x:Name="ConfirmationTextBox"
                         Style="{StaticResource Input.TextBox}"
                         Height="34"
                         TextChanged="ConfirmationTextBox_TextChanged" />
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource Button.Secondary}"
                        Height="34"
                        Click="CancelButton_Click" />

                <Button Grid.Column="2"
                        x:Name="ConfirmButton"
                        Content="Confirm"
                        Style="{StaticResource Button.Primary}"
                        Height="34"
                        Click="ConfirmButton_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
